{
    "name": "quillstack/di",
    "description": "The dependency injection container based on PSR-11: Container interface.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "dependency-injection",
        "container",
        "di",
        "di-container",
        "psr-11",
        "php8",
        "class",
        "properties",
        "property",
        "constructor"
    ],
    "homepage": "https://quillstack.org/di",
    "authors": [
        {
            "name": "Radek Ziemniewicz",
            "email": "radek@quillstack.org"
        }
    ],
    "require": {
        "php": "^8.1",
        "psr/container": "^1.1 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Quillstack\\DI\\": "src/",
            "Quillstack\\DI\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "quillstack/unit-tests": "^0.8"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "extra": {
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    },
    "scripts": {
        "test": "unit-tests",
        "test:coverage": "phpdbg -qrr vendor/bin/unit-tests",
        "stan": "phpstan analyse"
    }
}
